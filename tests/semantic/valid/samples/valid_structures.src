struct Point {
    int x;
    int y;
}

struct Rectangle {
    Point top_left;
    Point bottom_right;
}

fn area(Rectangle rect) -> int {
    int width = rect.bottom_right.x - rect.top_left.x;
    int height = rect.bottom_right.y - rect.top_left.y;
    return width * height;
}

fn main() -> int {
    Point p1;
    p1.x = 0;
    p1.y = 0;

    Point p2;
    p2.x = 10;
    p2.y = 10;

    Rectangle rect;
    rect.top_left = p1;
    rect.bottom_right = p2;

    return area(rect);
}