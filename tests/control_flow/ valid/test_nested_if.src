// Test nested if statements
fn main() -> int {
    int result = 0;

    // Test 1: if-else chain
    int x = 5;
    if (x < 0) {
        result = 1;
    } else if (x < 5) {
        result = 2;
    } else if (x < 10) {
        result = 3;
    } else {
        result = 4;
    }
    // x=5 -> result=3

    // Test 2: deeply nested ifs
    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;

    if (a == 1) {
        if (b == 2) {
            if (c == 3) {
                if (d == 4) {
                    result = result + 100;
                } else {
                    result = result + 10;
                }
            } else {
                result = result + 1;
            }
        } else {
            result = result + 1;
        }
    } else {
        result = result + 1;
    }
    // result = 3 + 100 = 103

    // Test 3: if with complex condition
    int p = 5;
    int q = 10;
    int r = 15;

    if (p < q && q < r) {
        result = result + 1000;
    }

    if (p > q || q > r) {
        result = result + 1;
    } else {
        result = result + 10000;
    }

    return result;
    // Expected: 3 + 100 + 1000 + 10000 = 11103
}