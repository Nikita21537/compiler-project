fn main() -> int {
    int result = 0;


    for (int i = 0; i < 5; i = i + 1) {
        result = result + i;
    }
    // result = 0+1+2+3+4 = 10


    int j = 0;
    for (j = 0; j < 3; j = j + 1) {
        result = result + j;
    }



    int k = 0;
    for (; k < 4; k = k + 1) {
        result = result + k;
    }


    int m = 0;
    for (int n = 0; ; n = n + 1) {
        if (n >= 5) {
            m = n;
            n = 100;
        } else {
            result = result + n;
        }
    }




    int sum = 0;
    for (int x = 0; x < 10; x = x + 1) {
        if (x == 5) {
            sum = sum + 100;
        } else {
            sum = sum + x;
        }
    }



    int nested_sum = 0;
    for (int a = 0; a < 3; a = a + 1) {
        for (int b = 0; b < 3; b = b + 1) {
            nested_sum = nested_sum + 1;
        }
    }


    return result + sum + nested_sum;

}